# Build output (regenerated by `cmake --build`)
pipeline/build/

# Runtime data: inputs, outputs, and GPU/TensorRT-version-locked artifacts.
# None of this is portable across machines or meaningful to version --
# see README.md for how to obtain/regenerate each piece.
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/model/*.engine

# GSHHG resolution sets not used by this project (only f/ full-resolution is
# referenced anywhere). Download separately from GSHHG if you need these.
data/GSHHS_shp/c/
data/GSHHS_shp/h/
data/GSHHS_shp/i/
data/GSHHS_shp/l/

# Local tool state, not project content.
miniconda3/
.claude/

# Common editor/OS noise.
.DS_Store
*.swp
