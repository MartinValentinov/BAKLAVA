# Build output (regenerated by `cmake --build`). Unanchored so it catches
# any build/ directory regardless of depth -- e.g. VS Code's CMake Tools
# extension defaults to a root-level build/ unless cmake.buildDirectory is
# set, separate from pipeline/build/ used by the manual CLI build.
build/

# Runtime data: inputs, outputs, and GPU/TensorRT-version-locked artifacts.
# None of this is portable across machines or meaningful to version --
# see README.md for how to obtain/regenerate each piece.
data/input/*
!data/input/.gitkeep
data/output/*
!data/output/.gitkeep
data/model/*.engine

# GSHHG resolution sets not used by this project (only f/ full-resolution is
# referenced anywhere). Download separately from GSHHG if you need these.
data/GSHHS_shp/c/
data/GSHHS_shp/h/
data/GSHHS_shp/i/
data/GSHHS_shp/l/

# Local tool state, not project content.
miniconda3/
.claude/

# Common editor/OS noise.
.DS_Store
*.swp
