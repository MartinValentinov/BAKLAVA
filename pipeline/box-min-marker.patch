 struct Pt { float x, y; };
 
-__device__ __forceinline__ void rbox_corners(const Det& d, Pt* c) {
+__device__ __forceinline__ void rbox_corners(const Det& d, float scale,
+                                             float minPx, Pt* c) {
     const float ca = __cosf(d.angle), sa = __sinf(d.angle);
-    const float hw = d.w * 0.5f, hh = d.h * 0.5f;
+    float hw = d.w * 0.5f * scale, hh = d.h * 0.5f * scale;
+
+    const float half = minPx * 0.5f;
+    const float big = fmaxf(hw, hh);
+    if (big < half) {
+        if (big > 1e-6f) { const float k = half / big; hw *= k; hh *= k; }
+        else             { hw = half; hh = half; }
+    }
+
+    const float cx = d.cx * scale, cy = d.cy * scale;
     const float ox[4] = {-hw,  hw, hw, -hw};
     const float oy[4] = {-hh, -hh, hh,  hh};
 #pragma unroll
