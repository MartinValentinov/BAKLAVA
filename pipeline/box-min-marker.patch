-    rbox_corners(dets[di], c);
-#pragma unroll
-    for (int i = 0; i < 4; ++i) { c[i].x *= scale; c[i].y *= scale; }
+    rbox_corners(dets[di], scale, minPx, c);
     const Pt a = c[ei], b = c[(ei + 1) & 3];
 
     const float dx = b.x - a.x, dy = b.y - a.y;
