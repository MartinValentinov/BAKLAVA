-        c[i].y = d.cy + ox[i] * sa + oy[i] * ca;
+        c[i].x = cx + ox[i] * ca - oy[i] * sa;
+        c[i].y = cy + ox[i] * sa + oy[i] * ca;
     }
 }
 
